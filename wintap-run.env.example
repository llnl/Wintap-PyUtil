# Copy this file to wintap-run.env and edit for your local run.
# Then use: source wintap-run.env

# Canonical run root. The Lintap/Wintap sensor writes data below this root.
export WINTAP_DATA_ROOT=/home/ubuntu/data/debug

# Optional overrides. The Makefile derives these from WINTAP_DATA_ROOT when unset.
# export WINTAP_DBT_DATASET=$WINTAP_DATA_ROOT
# export WINTAP_DBT_RAW_SENSOR_DATASET=s3://bucket/prefix/parquet
# export WINTAP_DBT_DATABASE=$WINTAP_DATA_ROOT/duckdb/wintap.duckdb

# Optional DBT day range, inclusive, matching dayPK values in raw_sensor/raw_process.
# When unset, the Makefile derives the min/max available dayPK values.
# export WINTAP_DBT_START_DAY=20260520
# export WINTAP_DBT_END_DAY=20260520
# Optional DBT hour range, inclusive, matching hourPK values in raw_sensor partitions.
# Useful with a narrow day window when you only need part of the day.
# export WINTAP_DBT_START_HOUR=08
# export WINTAP_DBT_END_HOUR=11
